{
  "name": "@knowledgeislands/mcp-housekeeping-chatgpt",
  "description": "MCP provider adapter for discovering and faithfully reading opaque local ChatGPT session records.",
  "version": "0.1.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "mcp-housekeeping-chatgpt": "dist/mcp-server/index.js"
  },
  "bugs": {
    "url": "https://github.com/knowledgeislands/mcp-housekeeping-chatgpt/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "mcporter": "^0.13.13",
    "rumdl": "^0.2.74",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./chatgpt": {
      "types": "./dist/main/chatgpt/local-store.d.ts",
      "import": "./dist/main/chatgpt/local-store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/knowledgeislands/mcp-housekeeping-chatgpt#readme",
  "keywords": [
    "chatgpt",
    "housekeeping",
    "knowledge-islands",
    "mcp",
    "sessions"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "main": "dist/mcp-server/index.js",
  "packageManager": "bun@1.4.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/mcp-housekeeping-chatgpt.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf {dist,node_modules}",
    "ki:deps:update": "bun update --latest",
    "ki:generate:client": "mcporter emit-ts kit-mcp-housekeeping-chatgpt --mode client --out src/generated/client.ts --types-out src/generated/types.d.ts && printf '// @ts-nocheck\\n' | cat - src/generated/client.ts > /tmp/gen-tmp.ts && mv /tmp/gen-tmp.ts src/generated/client.ts",
    "ki:server:mcp:dev": "NODE_ENV=development bun --watch src/mcp-server/index.ts",
    "ki:server:mcp:inspect": "NODE_ENV=development bunx @modelcontextprotocol/inspector bun src/mcp-server/index.ts",
    "ki:server:mcp:start": "bun run build && node dist/mcp-server/index.js",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
