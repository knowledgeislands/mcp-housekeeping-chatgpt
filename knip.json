{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/mcp-server/index.ts!",
    "src/config/index.ts!",
    "src/main/chatgpt/local-store.ts!",
    "src/main/codex/app-server.ts!",
    ".dependency-cruiser.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignore": ["src/generated/**", ".claude/skills/**", ".agents/skills/**"],
  "ignoreDependencies": ["lint-staged", "syncpack"],
