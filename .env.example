# Optional ChatGPT installed-application store; omit for Codex-only operation. A leading `~/` is expanded by the adapter.
MCP_HOUSEKEEPING_CHATGPT_PATH=~/Library/Application Support/com.openai.chat

# Read-only is the supported acquisition posture.
MCP_HOUSEKEEPING_CHATGPT_ACCESS_LEVEL=read

# Optional JSONL audit logging: off, writes, or all.
MCP_HOUSEKEEPING_CHATGPT_AUDIT_LOG=off

# Optional explicit audit-log path and rotation settings.
# MCP_HOUSEKEEPING_CHATGPT_AUDIT_LOG_PATH=~/.local/state/mcp-housekeeping-chatgpt/audit.jsonl
# MCP_HOUSEKEEPING_CHATGPT_AUDIT_LOG_MAX_BYTES=10485760
# MCP_HOUSEKEEPING_CHATGPT_AUDIT_LOG_KEEP=5
